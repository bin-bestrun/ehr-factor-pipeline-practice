# Python virtual environments
.venv/
venv/
**/.venv/

# Python caches and generated bytecode
__pycache__/
*.py[cod]

# Local EHR source data downloaded for practice
# Users should download these from UCI and place them in data/raw/.
data/raw/*.csv

# Generated encounter-level Parquet and reports may contain identifiers
# and should be recreated locally, not committed.
data/processed/*
!data/processed/.gitkeep

# Streamlit local secrets
.streamlit/secrets.toml

# Local/editor/OS files
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
New Text Document.txt
